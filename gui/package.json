{
  "name": "watchdog-desktop",
  "productName": "Watchdog",
  "version": "0.1.0",
  "description": "Desktop app for Watchdog — investigative document intelligence",
  "main": "./out/main/index.js",
  "author": "Tom Cardoso",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/tomcardoso/watchdog",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/check-colours.mjs",
    "test:e2e": "playwright test",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "engine:test": "node scripts/engine-cli.mjs",
    "predist": "node scripts/prepare-engine.mjs",
    "predist:mac": "node scripts/prepare-engine.mjs --target mac --arch arm64,x64",
    "predist:win": "node scripts/prepare-engine.mjs --target win --arch x64,arm64",
    "predist:linux": "node scripts/prepare-engine.mjs --target linux --arch x64",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "check:colours": "node scripts/check-colours.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomcardoso/watchdog.git",
    "directory": "gui"
  }
}
