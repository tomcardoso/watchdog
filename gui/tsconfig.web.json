{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["./src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"],
  "exclude": ["./src/renderer/src/**/*.test.ts"]
}
